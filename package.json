    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3001 --turbopack",
    "dev:notebook": "tsx scripts/dev-with-jupyter.ts",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:cli": "tsc -p tsconfig.cli.json",
    "prepare:app-bundle": "node scripts/prepare-app-bundle.mjs",
    "archive:app-bundle": "node scripts/archive-app-bundle.mjs",
    "prepack": "npm run build && npm run build:cli && npm run prepare:app-bundle && npm run archive:app-bundle",
    "package:npm": "npm pack --dry-run"
  },
