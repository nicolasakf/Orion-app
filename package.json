{
  "name": "orion-notebook",
  "version": "0.6.3",
  "description": "Local Orion CLI launcher for notebooks and Jupyter",
  "license": "Apache-2.0",
  "private": false,
  "bin": {
    "orion": "dist/cli/cli/orion.js"
  },
  "files": [
    "dist/cli",
    "dist/orion-app",
    "README.md",
    "LICENSE",
    "NOTICE"
